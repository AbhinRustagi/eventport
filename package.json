{
  "name": "eventport-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm --filter eventport build && pnpm -r --if-present check",
    "dev": "pnpm --filter @eventport/playground dev",
    "example": "pnpm --filter eventport build && pnpm --filter @eventport/playground example",
    "pack:lib": "pnpm --filter eventport pack",
    "test": "pnpm --filter eventport test && pnpm --filter @eventport/playground test",
    "docs:dev": "pnpm --filter @eventport/docs dev",
    "docs:build": "pnpm --filter @eventport/docs build"
  }
}
