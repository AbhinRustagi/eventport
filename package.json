{
  "name": "eventport-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter eventport build",
    "check": "pnpm --filter eventport check",
    "dev": "pnpm build && pnpm --filter @eventport/playground dev",
    "example": "pnpm build && pnpm --filter @eventport/playground example",
    "pack:lib": "pnpm --filter eventport pack",
    "test": "pnpm --filter eventport test"
  }
}
